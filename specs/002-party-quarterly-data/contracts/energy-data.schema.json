{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/energy-data.schema.json",
  "title": "EVG Erliweg All-Party Energy Data",
  "type": "object",
  "required": ["reportingStartDate", "partiesCatalog", "quarterlyRecords"],
  "properties": {
    "reportingStartDate": { "type": "string", "format": "date" },
    "partiesCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["partyId", "partyLabel", "joinedOn", "producerConfigurations"],
        "properties": {
          "partyId": { "type": "string", "minLength": 1 },
          "partyLabel": { "type": "string", "minLength": 1 },
          "joinedOn": { "type": "string", "format": "date" },
          "leftOn": { "type": "string", "format": "date" },
          "producerConfigurations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["isProducer", "activeFromQuarterId"],
              "properties": {
                "isProducer": { "type": "boolean" },
                "activeFromQuarterId": { "type": "string", "pattern": "^[0-9]{4}-Q[1-4]$" },
                "inactiveAfterQuarterId": { "type": "string", "pattern": "^[0-9]{4}-Q[1-4]$" },
                "pvSystem": {
                  "type": "object",
                  "required": ["peakPowerKwp", "orientation", "hasBattery"],
                  "properties": {
                    "peakPowerKwp": { "type": "number", "exclusiveMinimum": 0 },
                    "orientation": { "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW", "FLAT"] },
                    "hasBattery": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "quarterlyRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "year", "quarter", "startDate", "endDate", "partyRecords"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]{4}-Q[1-4]$" },
          "year": { "type": "integer", "minimum": 2025 },
          "quarter": { "type": "integer", "minimum": 1, "maximum": 4 },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "partyRecords": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["partyId", "producedKwh", "consumedKwh", "updatedAt"],
              "properties": {
                "partyId": { "type": "string", "minLength": 1 },
                "producedKwh": { "type": "number", "minimum": 0 },
                "consumedKwh": { "type": "number", "minimum": 0 },
                "updatedAt": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
