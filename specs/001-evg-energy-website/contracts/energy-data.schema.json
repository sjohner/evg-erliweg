{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/site-content.schema.json",
  "title": "EVG Erliweg Site Content",
  "type": "object",
  "required": ["community", "aboutContent", "contact"],
  "properties": {
    "community": {
      "type": "object",
      "required": ["name", "city", "country", "startDate", "totalParties", "totalPeople"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "format": "date" },
        "totalParties": { "type": "integer", "minimum": 1 },
        "totalPeople": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "aboutContent": {
      "type": "object",
      "required": ["summary", "termsUrl", "lastReviewedAt"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "termsUrl": { "type": "string", "format": "uri" },
        "lastReviewedAt": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "required": ["label", "type", "target"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["email", "form-link"] },
        "target": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
